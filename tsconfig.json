{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "paths": {
      "@/*": ["./*"]
    },
    "rootDir": ".",
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true

  },
  "include": [
    "server.ts",
    "controller/**/*.ts",
    "lib/**/*.ts",
    "middleware/**/*.ts",
    "model/**/*.ts",
    "router/**/*.ts",
    "services/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
