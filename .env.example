# ---------------------------------------------------------------------------
# Exam Warrior API — environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=5050

# MongoDB connection string. Local, or a free MongoDB Atlas cluster
# (mongodb+srv://user:pass@cluster.mongodb.net/examwarrior).
MONGODB_URI=mongodb://localhost:27017/examwarrior
# Optional. Connection pool size (default 10).
MONGO_MAX_POOL_SIZE=10

# --- Auth (required in production — the server refuses to boot without them) --
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# --- OTP delivery -----------------------------------------------------------
# ONE provider is enough. Without either, real phone numbers cannot log in.
# Twilio Verify (preferred — handles code generation, expiry and retries).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=

# MSG91 (India-focused alternative).
MSG91_AUTH_KEY=
MSG91_SENDER_ID=EXAMWR
MSG91_TEMPLATE_ID=

# --- AI question generation -------------------------------------------------
# Anthropic API key — powers the bilingual question engine (services/aiService).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Payments (Razorpay) ----------------------------------------------------
# Dashboard → Settings → API Keys. Use rzp_test_* keys in development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Plan IDs created under Razorpay → Subscriptions → Plans.
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=
# Dashboard → Settings → Webhooks. Used to verify webhook signatures.
RAZORPAY_WEBHOOK_SECRET=

# --- Push notifications (Firebase Cloud Messaging) --------------------------
# Provide ONE of the two. Path is handy locally; the inline JSON string suits
# hosts like Render where you cannot upload a file.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# --- Scheduled jobs ---------------------------------------------------------
# Master switch for the in-process node-cron scheduler (off by default).
ENABLE_CRON=false
CRON_TZ=Asia/Kolkata
# Shared secret for the machine-only /notifications/cron/* HTTP endpoints,
# sent as the `x-cron-secret` header by an external scheduler.
CRON_SECRET=replace_with_a_long_random_string
# Optional cron schedule overrides (standard cron syntax, defaults in lib/cron.ts).
# CRON_STREAK_TIME=0 20 * * *
# CRON_WEAKTOPIC_TIME=0 17 * * 1,3,5
# CRON_TRIAL_TIME=30 10 * * *
# CRON_RANK_TIME=0 18 * * 0
# CRON_REFERRAL_TIME=0 19 * * 6
# CRON_ROOM_FINALIZE_TIME=* * * * *
# CRON_ASSESSMENT_FINALIZE_TIME=* * * * *
# CRON_LEAGUE_TIME=30 0 * * 1

# --- Gameplay tuning (all optional — sensible defaults in code) -------------
# Classroom Battle rooms.
ROOM_SECONDS_PER_QUESTION=60
ROOM_LIMIT_FREE=2
ROOM_LIMIT_PAID=20
# Institute assessments.
ASSESSMENT_SECONDS_PER_QUESTION=60
# Weekly league promote/demote cut-offs.
LEAGUE_PROMOTE=5
LEAGUE_DEMOTE=5

# --- Referrals --------------------------------------------------------------
# Base URL used to build shareable referral links.
REFERRAL_WEB_BASE=https://examwarrior.app
